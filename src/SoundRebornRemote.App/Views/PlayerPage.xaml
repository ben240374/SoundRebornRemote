<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SoundRebornRemote.App.ViewModels"
             xmlns:views="clr-namespace:SoundRebornRemote.App.Views"
             x:Class="SoundRebornRemote.App.Views.PlayerPage"
             x:DataType="vm:PlayerViewModel"
             Title="{DynamicResource L_TabPlayer}">

    <!-- Titre de la page et nom de l'application (AppTitleBar). -->
    <Shell.TitleView>
        <views:AppTitleBar TitleKey="L_TabPlayer" />
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="14,10,14,28" Spacing="12">

            <!--
                ================================================= Nouvelle version
                Bannière de UpdateViewModel, posée par la page dans son code. Visible
                seulement quand une version plus récente existe sur GitHub.
            -->
            <!-- IsVisible sur le ContentView lui-même : posé sur la carte intérieure, Android
                 gardait la place de la carte cachée, un grand bloc blanc en haut de page. -->
            <ContentView x:Name="UpdateBanner" x:DataType="vm:UpdateViewModel" IsVisible="{Binding ShowBanner}">
                <Border Style="{StaticResource Card}" Padding="12,10"
                        Stroke="{StaticResource AccentBrush}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding UpdateTitle}" FontAttributes="Bold" FontSize="15" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Button Grid.Column="0" Text="{DynamicResource L_UpdateNotes}" FontSize="13"
                                    Command="{Binding OpenPageCommand}" />
                            <Button Grid.Column="1" Text="{DynamicResource L_UpdateLater}" FontSize="13"
                                    Style="{StaticResource QuietButton}" Command="{Binding LaterCommand}" />
                            <Button Grid.Column="2" Text="{DynamicResource L_UpdateInstall}" FontSize="13"
                                    Style="{StaticResource AccentButton}" Command="{Binding InstallCommand}" />
                        </Grid>
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{Binding IsError, Converter={StaticResource ErrorColor}}"
                               FontSize="13" LineBreakMode="WordWrap"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>
                </Border>
            </ContentView>

            <!-- ================================================= Enceintes -->
            <Border Style="{StaticResource Card}" Padding="12,12,12,8">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{DynamicResource L_Speaker}" Style="{StaticResource SectionLabel}"
                               VerticalOptions="Center" />

                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                                     Fill="{StaticResource SuccessBrush}" IsVisible="{Binding IsLive}" />
                            <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                                     IsVisible="{Binding IsLive, Converter={StaticResource InvertedBool}}"
                                     Fill="{AppThemeBinding Light={StaticResource MutedBrushLight}, Dark={StaticResource MutedBrushDark}}" />
                            <Label Text="{Binding LiveLabel}" Style="{StaticResource CaptionLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!--
                        Disposition souple plutôt qu'une liste horizontale à largeur
                        fixe : chaque carte occupe la moitié de la place disponible et
                        passe d'elle-même à la ligne suivante. Plus rien ne dépasse,
                        quelle que soit la largeur de l'écran ou le nombre d'enceintes.
                    -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding SpeakerChoices}"
                                Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween" AlignItems="Stretch">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpeakerChoice">
                                <!-- 48 % laisse l'écart entre les deux colonnes ; avec une
                                     marge horizontale, deux cartes dépasseraient 100 %. -->
                                <Border Style="{StaticResource TileCard}" Padding="10,8"
                                        FlexLayout.Basis="48%" Margin="0,0,0,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlayerViewModel}}, Path=SelectSpeakerCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Path Grid.Column="0" Style="{StaticResource IconPath}"
                                              WidthRequest="18" HeightRequest="18" VerticalOptions="Start"
                                              Margin="0,2,0,0"
                                              Data="M4,9 H7.5 L12.5,5 V19 L7.5,15 H4 Z" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                                   LineBreakMode="WordWrap" MaxLines="2" />
                                            <Label Text="{Binding Model}" Style="{StaticResource CaptionLabel}"
                                                   LineBreakMode="WordWrap" MaxLines="2" />
                                            <Label Text="{Binding AgentVersion}" Style="{StaticResource CaptionLabel}"
                                                   IsVisible="{Binding HasAgent}" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Un cadre vide ne dit pas s'il faut attendre ou agir. -->
                    <Label Text="{DynamicResource L_NoSpeakerDetail}" Style="{StaticResource CaptionLabel}"
                           Margin="0,0,0,4" IsVisible="{Binding SpeakerListEmpty}" />

                </VerticalStackLayout>
            </Border>

            <!-- ================================================= En ce moment -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource L_RightNow}" Style="{StaticResource SectionLabel}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                        <Border Grid.Column="0" Style="{StaticResource TileCard}" WidthRequest="72" HeightRequest="72"
                                VerticalOptions="Start">
                            <Grid>
                                <Image Source="{Binding ArtSource}" Aspect="AspectFit" Margin="6"
                                       IsVisible="{Binding HasArt}" />
                                <Label Text="{Binding ArtGlyph}" FontSize="26"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding HasArt, Converter={StaticResource InvertedBool}}" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Title}" Style="{StaticResource TitleLabel}"
                                   LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource SubtitleLabel}"
                                   LineBreakMode="TailTruncation" MaxLines="1"
                                   IsVisible="{Binding Subtitle, Converter={StaticResource StringNotEmpty}}" />
                            <Label Text="{Binding SourceLabel}" Style="{StaticResource CaptionLabel}"
                                   LineBreakMode="TailTruncation" MaxLines="1" />
                        </VerticalStackLayout>

                    </Grid>

                    <!--
                        Avancement du morceau, quand l'enceinte en connaît la durée
                        (Spotify de l'enceinte, bibliothèque). Visibilité sur la grille
                        qui enveloppe : cachée, elle ne réserve aucune place.
                    -->
                    <Grid IsVisible="{Binding HasProgress}" RowDefinitions="Auto,Auto" RowSpacing="2">
                        <ProgressBar Grid.Row="0" Progress="{Binding Progress}" ProgressColor="{StaticResource Accent}" />
                        <Label Grid.Row="1" Text="{Binding ProgressText}" Style="{StaticResource CaptionLabel}"
                               HorizontalOptions="End" />
                    </Grid>

                    <!--
                        « J'aime » / « Je n'aime pas » pour le titre Spotify en cours
                        (agent 1.8.1+). Sa propre vue-modèle : BindingContext sur le
                        ContentView, type compilé sur le bloc enfant.

                        La visibilité est posée sur une grille qui enveloppe le tout et
                        garde la vue-modèle de la page (Like.ShowButtons) : cachée, la
                        carte ne lui réserve plus aucune place. Posée sur le bloc enfant
                        seul, le ContentView gardait sur Android la hauteur des boutons
                        après le passage de Spotify à une radio : un grand vide restait
                        sous le titre.
                    -->
                    <Grid IsVisible="{Binding Like.ShowButtons}">
                    <ContentView BindingContext="{Binding Like}">
                        <VerticalStackLayout x:DataType="vm:SpotifyLikeViewModel" Spacing="6" IsVisible="{Binding ShowButtons}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0" Text="{DynamicResource L_Like}" Style="{StaticResource AccentButton}"
                                        Command="{Binding LikeCommand}" />
                                <Button Grid.Column="1" Text="{DynamicResource L_Unlike}"
                                        Command="{Binding UnlikeCommand}" />
                            </Grid>
                            <Label Text="{Binding Note}"
                                   TextColor="{Binding NoteIsError, Converter={StaticResource ErrorColor}}"
                                   FontSize="13" LineBreakMode="WordWrap"
                                   IsVisible="{Binding Note, Converter={StaticResource StringNotEmpty}}" />
                            <Label Text="{DynamicResource L_LikedAccount}" Style="{StaticResource CaptionLabel}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </ContentView>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ================================================= Commandes -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{DynamicResource L_Controls}" Style="{StaticResource SectionLabel}" />

                    <HorizontalStackLayout Spacing="14" HorizontalOptions="Center">

                        <!-- Arrêt -->
                        <Border Style="{StaticResource IconCircle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding StopCommand}" />
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPath}" Data="M6,6 H18 V18 H6 Z" />
                        </Border>

                        <!-- Précédent -->
                        <Border Style="{StaticResource IconCircle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousCommand}" />
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPath}" Data="M7,5 H9.5 V19 H7 Z M18,5 L10,12 L18,19 Z" />
                        </Border>

                        <!-- Lecture / pause : deux tracés, un seul visible à la fois -->
                        <Border Style="{StaticResource IconCircleAccent}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PlayPauseCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Path Style="{StaticResource IconPathOnAccent}" Data="M8,5 L19,12 L8,19 Z"
                                      IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBool}}" />
                                <Path Style="{StaticResource IconPathOnAccent}"
                                      Data="M7,5 H11 V19 H7 Z M13,5 H17 V19 H13 Z"
                                      IsVisible="{Binding IsPlaying}" />
                            </Grid>
                        </Border>

                        <!-- Suivant -->
                        <Border Style="{StaticResource IconCircle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextCommand}" />
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPath}" Data="M17,5 H14.5 V19 H17 Z M6,5 L14,12 L6,19 Z" />
                        </Border>

                    </HorizontalStackLayout>

                    <!-- Marche / arrêt : vert quand l'enceinte joue, gris en veille -->
                    <Border Style="{StaticResource PowerPill}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PowerCommand}" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Path Style="{StaticResource IconStrokeOnAccent}"
                                  Data="M12,3 L12,11 M7.05,6.05 A 7,7 0 1 0 16.95,6.05" />
                            <Label Text="{Binding PowerLabel}" TextColor="{StaticResource OnAccent}"
                                   FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsStandby}" Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource PowerOn}" />
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>

                    <!--
                        Minuterie de sommeil. Elle vise la même enceinte que le bouton
                        de veille, et n'apparaît que si son agent la connaît.
                    -->
                    <Button Text="{Binding SleepLabel}" Style="{StaticResource QuietButton}"
                            Command="{Binding SleepCommand}" HorizontalOptions="Center"
                            IsVisible="{Binding SleepAvailable}" />

                </VerticalStackLayout>
            </Border>

            <!-- ================================================= Volume -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{DynamicResource L_Volume}" Style="{StaticResource SectionLabel}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding VolumeLabel}" Style="{StaticResource ValueLabel}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">

                        <!-- Sourdine : haut-parleur, barré quand le son est coupé -->
                        <Border Grid.Column="0" Style="{StaticResource IconSquare}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleMuteCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Path Style="{StaticResource IconPath}" Data="M4,9 H7.5 L12.5,5 V19 L7.5,15 H4 Z" />
                                <Path Aspect="Uniform" WidthRequest="21" HeightRequest="21"
                                      HorizontalOptions="Center" VerticalOptions="Center"
                                      StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                      Stroke="{AppThemeBinding Light={StaticResource IconBrushLight}, Dark={StaticResource IconBrushDark}}"
                                      Data="M15.5,9 A 4,4 0 0 1 15.5,15"
                                      IsVisible="{Binding IsMuted, Converter={StaticResource InvertedBool}}" />
                                <Path Aspect="Uniform" WidthRequest="21" HeightRequest="21"
                                      HorizontalOptions="Center" VerticalOptions="Center"
                                      StrokeThickness="1.8" StrokeLineCap="Round" Fill="Transparent"
                                      Stroke="{StaticResource DangerBrush}"
                                      Data="M15.5,9.5 L20,14.5 M20,9.5 L15.5,14.5"
                                      IsVisible="{Binding IsMuted}" />
                            </Grid>
                        </Border>

                        <!--
                            Égaliser : met toutes les enceintes du groupe à la valeur
                            affichée. Signe « égal », et seulement quand un groupe est
                            actif — seul il n'y a rien à égaliser.
                        -->
                        <Border Grid.Column="1" Style="{StaticResource IconSquare}"
                                IsVisible="{Binding HasGroupVolume}"
                                SemanticProperties.Description="{DynamicResource L_LevelGroup}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LevelGroupCommand}" />
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPath}" Data="M5,9 H19 V11 H5 Z M5,13 H19 V15 H5 Z" />
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource IconSquare}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding VolumeStepCommand}" CommandParameter="-1" />
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPath}" Data="M5,11 H19 V13 H5 Z" />
                        </Border>

                        <Slider Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}"
                                VerticalOptions="Center" />

                        <Border Grid.Column="4" Style="{StaticResource IconSquare}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding VolumeStepCommand}" CommandParameter="1" />
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPath}" Data="M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z" />
                        </Border>

                    </Grid>

                    <!-- En groupe, le curseur ci-dessus règle TOUT le groupe. -->
                    <VerticalStackLayout Spacing="1" IsVisible="{Binding HasGroupVolume}">
                        <Label Text="{DynamicResource L_VolumeOfGroup}" Style="{StaticResource CaptionLabel}" />
                        <Label Text="{DynamicResource L_LevelGroupHint}" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>

                    <!-- ===== Réglage enceinte par enceinte ===== -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasGroupVolume}">

                        <BoxView HeightRequest="1" Margin="0,4"
                                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                        <Label Text="{DynamicResource L_PerSpeaker}" Style="{StaticResource SectionLabel}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding GroupMembers}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:MemberVolume">
                                    <VerticalStackLayout Spacing="0" Padding="0,2"
                                                         Opacity="{Binding IsReachable, Converter={StaticResource ReadyOpacity}}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                            <Label Grid.Column="1" Text="{Binding VolumeLabel}"
                                                   Style="{StaticResource CaptionLabel}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Border Grid.Column="0" Style="{StaticResource IconSquareSmall}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding StepCommand}" CommandParameter="-1" />
                                                </Border.GestureRecognizers>
                                                <Path Style="{StaticResource IconPathSmall}" Data="M5,11 H19 V13 H5 Z" />
                                            </Border>

                                            <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                    Value="{Binding Volume, Mode=TwoWay}" VerticalOptions="Center" />

                                            <Border Grid.Column="2" Style="{StaticResource IconSquareSmall}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding StepCommand}" CommandParameter="1" />
                                                </Border.GestureRecognizers>
                                                <Path Style="{StaticResource IconPathSmall}" Data="M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z" />
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- ================================================= Graves -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding BassAvailable}">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{DynamicResource L_Bass}" Style="{StaticResource SectionLabel}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding BassLabel}" Style="{StaticResource ValueLabel}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Border Grid.Column="0" Style="{StaticResource IconSquare}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BassStepCommand}" CommandParameter="-1" />
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPath}" Data="M5,11 H19 V13 H5 Z" />
                        </Border>

                        <Slider Grid.Column="1" Minimum="{Binding BassMinimum}" Maximum="{Binding BassMaximum}"
                                Value="{Binding Bass, Mode=TwoWay}" VerticalOptions="Center" />

                        <Border Grid.Column="2" Style="{StaticResource IconSquare}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BassStepCommand}" CommandParameter="1" />
                            </Border.GestureRecognizers>
                            <Path Style="{StaticResource IconPath}" Data="M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z" />
                        </Border>
                    </Grid>

                    <Label Style="{StaticResource CaptionLabel}" Text="{DynamicResource L_BassNote}" />

                </VerticalStackLayout>
            </Border>

            <!-- ================================================= Présélections -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource L_Presets}" Style="{StaticResource SectionLabel}" />

                    <!--
                        « Une fois » : les six touches. « Deux fois » : la même touche
                        pressée deux fois, seulement si l'agent de l'enceinte gère ces
                        six touches-là. « Local », à droite : les présélections gardées
                        dans le téléphone, en nombre libre. « ★ STR » : les favoris STR,
                        les mêmes sur toutes les enceintes (agent récent).

                        Les pastilles portent un dessin plutôt qu'un mot, pour tenir sur une
                        ligne : un doigt levé (une fois), deux doigts (deux fois), un téléphone
                        (Local), une étoile (STR). Leur nom reste lu par TalkBack et s'affiche
                        sur un appui long.

                        Deux groupes, chacun d'un seul tenant : « Une fois » et « Deux fois » à
                        gauche, « Local » et « ★ STR » à droite. Quand la largeur ne suffit pas
                        (petit téléphone), le groupe de droite passe à la ligne au lieu de
                        chevaucher celui de gauche. Une puce masquée ne laisse pas de trou : elle
                        est dans un groupe, et le groupe ne compte que ses puces visibles.
                    -->
                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center">
                        <HorizontalStackLayout Spacing="8" Margin="0,3" FlexLayout.Shrink="0">
                            <Border Style="{StaticResource Chip}" Padding="12,6"
                                    SemanticProperties.Description="{DynamicResource L_RowOnce}"
                                    ToolTipProperties.Text="{DynamicResource L_RowOnce}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowPresetRowCommand}" CommandParameter="1" />
                                </Border.GestureRecognizers>

                                <!-- Pastille : nombre de touches garnies dans la première rangée. -->
                                <HorizontalStackLayout Spacing="6">
                                    <!-- Un doigt levé : une pression sur la touche. -->
                                    <Path Style="{StaticResource IconPath}" WidthRequest="18" HeightRequest="18"
                                          Data="F1 M6.4,14 V3.5 A2,2 0 0 1 10.4,3.5 V14 Z M10.65,13.2 V12.6 A1.75,1.75 0 0 1 14.15,12.6 V13.2 Z M13.85,13.2 V12.6 A1.75,1.75 0 0 1 17.35,12.6 V13.2 Z M8.8,12 H15.4 A3.2,3.2 0 0 1 18.6,15.2 V19.3 A3.2,3.2 0 0 1 15.4,22.5 H8.8 A3.2,3.2 0 0 1 5.6,19.3 V15.2 A3.2,3.2 0 0 1 8.8,12 Z" />
                                    <Border Style="{StaticResource CountBadge}" IsVisible="{Binding ShowFirstRowCount}">
                                        <Label Text="{Binding FirstRowCount}" Style="{StaticResource CountBadgeLabel}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding OnceSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <Border Style="{StaticResource Chip}" Padding="12,6" IsVisible="{Binding HasSecondRow}"
                                    SemanticProperties.Description="{DynamicResource L_RowTwice}"
                                    ToolTipProperties.Text="{DynamicResource L_RowTwice}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowPresetRowCommand}" CommandParameter="2" />
                                </Border.GestureRecognizers>

                                <!-- Pastille : nombre de touches garnies dans cette rangée. -->
                                <HorizontalStackLayout Spacing="6">
                                    <!-- Deux doigts levés : deux pressions sur la touche. -->
                                    <Path Style="{StaticResource IconPath}" WidthRequest="18" HeightRequest="18"
                                          Data="F1 M5.6,14 V4.5 A1.9,1.9 0 0 1 9.4,4.5 V14 Z M9.9,14 V3.4 A1.9,1.9 0 0 1 13.7,3.4 V14 Z M13.9,13.4 V12.8 A1.6,1.6 0 0 1 17.1,12.8 V13.4 Z M8.4,12 H15.4 A3.2,3.2 0 0 1 18.6,15.2 V19.3 A3.2,3.2 0 0 1 15.4,22.5 H8.4 A3.2,3.2 0 0 1 5.2,19.3 V15.2 A3.2,3.2 0 0 1 8.4,12 Z" />
                                    <Border Style="{StaticResource CountBadge}" IsVisible="{Binding ShowSecondRowCount}">
                                        <Label Text="{Binding SecondRowCount}" Style="{StaticResource CountBadgeLabel}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding TwiceSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8" Margin="0,3" FlexLayout.Shrink="0">
                            <Border Style="{StaticResource Chip}" Padding="12,6"
                                    SemanticProperties.Description="{DynamicResource L_RowLocal}"
                                    ToolTipProperties.Text="{DynamicResource L_RowLocal}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowLocalCommand}" />
                                </Border.GestureRecognizers>

                                <!-- Pastille : nombre de présélections locales. -->
                                <HorizontalStackLayout Spacing="6">
                                    <!-- Un téléphone : les présélections gardées dans le téléphone. -->
                                    <Path Style="{StaticResource IconPath}" WidthRequest="18" HeightRequest="18"
                                          Data="F0 M9.0,1.5 H15.0 A2.5,2.5 0 0 1 17.5,4.0 V20.0 A2.5,2.5 0 0 1 15.0,22.5 H9.0 A2.5,2.5 0 0 1 6.5,20.0 V4.0 A2.5,2.5 0 0 1 9.0,1.5 Z M8.9,4.2 H15.1 A0.6,0.6 0 0 1 15.7,4.8 V17.2 A0.6,0.6 0 0 1 15.1,17.8 H8.9 A0.6,0.6 0 0 1 8.3,17.2 V4.8 A0.6,0.6 0 0 1 8.9,4.2 Z M12,19 A1.2,1.2 0 1 1 12,21.4 A1.2,1.2 0 1 1 12,19 Z" />
                                    <Border Style="{StaticResource CountBadge}" IsVisible="{Binding Local.ShowCount}">
                                        <Label Text="{Binding Local.Count}" Style="{StaticResource CountBadgeLabel}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Local.IsShown}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <!-- Favoris STR, quand l'agent les connaît, avec leur nombre en pastille. -->
                            <Border Style="{StaticResource Chip}" Padding="12,6" IsVisible="{Binding Favorites.IsAvailable}"
                                    SemanticProperties.Description="{DynamicResource L_RowFavorites}"
                                    ToolTipProperties.Text="{DynamicResource L_RowFavorites}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowFavoritesCommand}" />
                                </Border.GestureRecognizers>

                                <!-- Une étoile : les favoris STR ; pastille : leur nombre. -->
                                <HorizontalStackLayout Spacing="6">
                                    <Path Style="{StaticResource IconPath}" WidthRequest="18" HeightRequest="18"
                                          Data="F0 M12,2.3 L14.53,9.32 L21.99,9.56 L16.09,14.13 L18.17,21.29 L12,17.1 L5.83,21.29 L7.91,14.13 L2.01,9.56 L9.47,9.32 Z" />
                                    <Border Style="{StaticResource CountBadge}" IsVisible="{Binding Favorites.ShowCount}">
                                        <Label Text="{Binding Favorites.Count}" Style="{StaticResource CountBadgeLabel}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Favorites.IsShown}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <CollectionView ItemsSource="{Binding Presets}" HeightRequest="284" IsVisible="{Binding ShowKeys}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3"
                                             HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresetTile">
                                <Border Style="{StaticResource TileCard}" HeightRequest="134">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlayerViewModel}}, Path=RecallPresetCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <!-- Le nom de la touche, seul : on renomme et on efface dans l'onglet Présélections. -->
                                        <Label Grid.Row="0" Text="{Binding Header}" Style="{StaticResource CaptionLabel}"
                                               FontSize="11" Padding="8,5,8,0"
                                               LineBreakMode="TailTruncation" MaxLines="1" />

                                        <Image Grid.Row="1" Source="{Binding ArtSource}" Aspect="AspectFit"
                                               Margin="10,4,10,2" IsVisible="{Binding HasArt}" />

                                        <Label Grid.Row="1" Text="{Binding Glyph}" FontSize="30"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding HasArt, Converter={StaticResource InvertedBool}}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />

                                        <Label Grid.Row="2" Text="{Binding Name}" FontSize="12"
                                               Padding="6,6" LineBreakMode="TailTruncation" MaxLines="1"
                                               HorizontalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Success}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- La liste « Local », à la place de la grille. Visibilité sur la grille englobante (voir LocalPresetsView). -->
                    <Grid IsVisible="{Binding Local.IsShown}">
                        <views:LocalPresetsView BindingContext="{Binding Local}" />
                    </Grid>

                    <!-- La liste des favoris STR, à la place de la grille, comme « Local ». -->
                    <Grid IsVisible="{Binding Favorites.IsShown}">
                        <views:StrFavoritesView BindingContext="{Binding Favorites}" />
                    </Grid>


                    <!-- Range sur une touche ce que l'enceinte joue en ce moment (pas dans la liste « Local », qui a ses propres boutons). -->
                    <Grid IsVisible="{Binding ShowKeys}">
                        <Button Text="{DynamicResource L_KeepPlaying}" Style="{StaticResource QuietButton}"
                                Command="{Binding SavePlayingCommand}" HorizontalOptions="Center"
                                IsVisible="{Binding HasStrAgent}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--
                ================================================= Message vocal
                Sa propre vue-modèle (VoiceMessageViewModel), posée par la page
                dans son code. La visibilité est sur le ContentView lui-même.
            -->
            <ContentView x:Name="VoiceCard" x:DataType="vm:VoiceMessageViewModel" IsVisible="{Binding ShowCard}">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{DynamicResource L_VoiceTitle}" Style="{StaticResource SectionLabel}" />

                        <!--
                            Ma voix : maintenir le bouton rond pour parler, relâcher pour
                            envoyer. Les événements Pressed et Released du bouton sont
                            relayés par la page (OnVoicePressed / OnVoiceReleased) : un
                            bouton n'a de commande que pour l'appui complet. Le micro est
                            un tracé posé par-dessus, transparent aux appuis.
                        -->
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center" IsVisible="{Binding RecorderSupported}">
                            <Grid WidthRequest="84" HeightRequest="84" HorizontalOptions="Center">
                                <!-- Couleur par le style, pas en valeur locale : le déclencheur doit pouvoir la passer au rouge. -->
                                <Button x:Name="VoiceButton" Style="{StaticResource AccentButton}"
                                        WidthRequest="84" HeightRequest="84" CornerRadius="42"
                                        Padding="0" MinimumHeightRequest="84"
                                        IsEnabled="{Binding CanRecord}"
                                        SemanticProperties.Description="{DynamicResource L_VoiceHoldHint}"
                                        Pressed="OnVoicePressed" Released="OnVoiceReleased">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Path Style="{StaticResource IconStrokeOnAccent}" InputTransparent="True"
                                      WidthRequest="30" HeightRequest="30" StrokeThickness="2.2"
                                      Data="M12,3 A3,3 0 0 1 15,6 V12 A3,3 0 0 1 9,12 V6 A3,3 0 0 1 12,3 Z M6,11 A6,6 0 0 0 18,11 M12,17 V21 M9,21 H15" />
                            </Grid>
                            <Label Text="{Binding HoldHint}" Style="{StaticResource CaptionLabel}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding ElapsedText}" Style="{StaticResource ValueLabel}"
                                   HorizontalOptions="Center" IsVisible="{Binding IsRecording}" />
                        </VerticalStackLayout>

                        <!-- Texte lu par l'enceinte, voix de Google, dans la langue de l'application. -->
                        <Entry Text="{Binding Text}" Placeholder="{DynamicResource L_VoiceTextPlaceholder}"
                               MaxLength="200" ReturnType="Send" ReturnCommand="{Binding SpeakCommand}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="{DynamicResource L_VoiceSpeak}" Style="{StaticResource QuietButton}"
                                    Command="{Binding SpeakCommand}" IsEnabled="{Binding CanSpeak}" />
                            <Button Grid.Column="1" Text="{DynamicResource L_VoiceKeep}" Style="{StaticResource QuietButton}"
                                    Command="{Binding KeepTextCommand}" IsEnabled="{Binding CanKeep}" />
                        </Grid>

                        <!-- Les textes gardés (dix au plus) : appui pour les faire lire, ✎ modifier, ✕ supprimer. -->
                        <VerticalStackLayout Spacing="0" IsVisible="{Binding HasTexts}">
                            <Label Text="{DynamicResource L_VoiceTexts}" Style="{StaticResource CaptionLabel}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Texts}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SavedVoiceText">
                                        <Grid Padding="2,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VoiceMessageViewModel}}, Path=SpeakSavedCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <Label Grid.Column="0" Text="▶" FontSize="15" VerticalOptions="Center"
                                                   TextColor="{StaticResource Accent}" />
                                            <Label Grid.Column="1" Text="{Binding Text}" FontSize="15" VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation" MaxLines="2" />
                                            <Button Grid.Column="2" Text="✎" Style="{StaticResource TileIconButton}" VerticalOptions="Center"
                                                    SemanticProperties.Description="{DynamicResource L_VoiceTextEditGo}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VoiceMessageViewModel}}, Path=EditTextCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="3" Text="✕" Style="{StaticResource TileIconButton}" VerticalOptions="Center"
                                                    TextColor="{StaticResource Danger}"
                                                    SemanticProperties.Description="{DynamicResource L_VoiceTextDeleteGo}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VoiceMessageViewModel}}, Path=DeleteTextCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!--
                            Volume des annonces, voix et texte : tout à gauche, celui de
                            l'enceinte ; sinon le volume fixé le temps du message.
                        -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding VolumeLabel}" Style="{StaticResource CaptionLabel}" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding AnnounceVolume, Mode=TwoWay}" />
                        </VerticalStackLayout>

                        <ActivityIndicator IsRunning="{Binding IsSending}" IsVisible="{Binding IsSending}"
                                           HorizontalOptions="Start" HeightRequest="22" />

                        <!-- Le message d'état, et « Réessayer » quand le dernier message n'est pas parti. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                              IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}">
                            <Label Grid.Column="0" Text="{Binding StatusMessage}"
                                   TextColor="{Binding IsError, Converter={StaticResource ErrorColor}}"
                                   FontSize="13" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="{DynamicResource L_VoiceRetry}" Style="{StaticResource QuietButton}"
                                    Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <Label Text="{DynamicResource L_VoiceHint}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </ContentView>

            <!-- ================================================= Groupement rapide -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasSeveralSpeakers}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource L_GroupWith}" Style="{StaticResource SectionLabel}" />

                    <!--
                        Cette enceinte suit déjà un groupe mené par une autre : on le dit
                        au lieu de laisser croire qu'il reste un groupe à former.
                    -->
                    <VerticalStackLayout Spacing="1" IsVisible="{Binding ShowGroupedBanner}">
                        <Label Text="{Binding GroupedWithLabel}" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Warning}" />
                        <Label Text="{DynamicResource L_SlaveOfGroup}" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>

                    <FlexLayout BindableLayout.ItemsSource="{Binding GroupCandidates}"
                                Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpeakerChoice">
                                <Border Style="{StaticResource Chip}" Margin="0,0,8,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlayerViewModel}}, Path=ToggleGroupCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <HorizontalStackLayout Spacing="8">
                                        <!-- Coche visible seulement quand l'enceinte suit le groupe -->
                                        <Path Style="{StaticResource IconPath}" WidthRequest="16" HeightRequest="16"
                                              Fill="{StaticResource SuccessBrush}"
                                              Data="M5,12.5 L9.5,17 L19,7.5 L17.5,6 L9.5,14 L6.5,11 Z"
                                              IsVisible="{Binding IsGrouped}" />
                                        <Label Text="{Binding Name}" FontSize="14" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsGrouped}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Success}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Groupement en cours, puis son résultat : visible là où l'on vient d'appuyer. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                          IsVisible="{Binding GroupNote, Converter={StaticResource StringNotEmpty}}">
                        <ActivityIndicator Grid.Column="0" WidthRequest="18" HeightRequest="18" VerticalOptions="Center"
                                           IsRunning="{Binding IsGroupWorking}" IsVisible="{Binding IsGroupWorking}" />
                        <Label Grid.Column="1" Text="{Binding GroupNote}" FontSize="13" LineBreakMode="WordWrap"
                               TextColor="{Binding GroupNoteIsError, Converter={StaticResource ErrorColor}}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{DynamicResource L_TapToUngroup}" Style="{StaticResource CaptionLabel}"
                           IsVisible="{Binding ShowUngroupHint}" />
                </VerticalStackLayout>
            </Border>

            <!-- ================================================= Pied -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="{Binding SpeakerDetail}" Style="{StaticResource CaptionLabel}"
                       VerticalOptions="Center" LineBreakMode="TailTruncation" />

                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <ActivityIndicator WidthRequest="16" HeightRequest="16"
                                       IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Button Text="{DynamicResource L_Refresh}" Style="{StaticResource QuietButton}"
                            Command="{Binding RefreshAllCommand}" />
                </HorizontalStackLayout>
            </Grid>

            <Label Text="{Binding StatusMessage}"
                   TextColor="{Binding IsError, Converter={StaticResource ErrorColor}}"
                   FontSize="13"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
