<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SoundRebornRemote.App.ViewModels"
             xmlns:models="clr-namespace:SoundReborn.Core.Models;assembly=SoundReborn.Core"
             x:Class="SoundRebornRemote.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{DynamicResource L_TabSettings}">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,24" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{DynamicResource L_ActiveSpeaker}" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding CurrentSpeakerLabel}" Style="{StaticResource SubtitleLabel}" />

                    <!-- Dans un groupe, les commandes partent vers le maître : on le dit. -->
                    <Label Text="{Binding RedirectNote}" Style="{StaticResource CaptionLabel}"
                           TextColor="{StaticResource Warning}" LineBreakMode="WordWrap"
                           IsVisible="{Binding IsRedirected}" />
                </VerticalStackLayout>
            </Border>

            <!--
                Réveils et volume de départ de l'enceinte DÉSIGNÉE. Le ContentView reçoit
                son BindingContext avec le type de la page ; le type des réveils ne vaut
                qu'à l'intérieur, sur le bloc enfant.
            -->
            <ContentView BindingContext="{Binding Alarms}">
                <VerticalStackLayout x:DataType="vm:AlarmsViewModel" Spacing="14">

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{DynamicResource L_AlarmsTitle}" Style="{StaticResource SectionLabel}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="{DynamicResource L_Refresh}" Style="{StaticResource QuietButton}"
                                        Command="{Binding RefreshCommand}" />
                            </Grid>

                            <Label Text="{Binding SpeakerLabel}" Style="{StaticResource SubtitleLabel}" />

                            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />

                            <Label Text="{Binding UnavailableNote}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap"
                                   IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBool}}" />

                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAvailable}">
                                <Label Text="{Binding WarningText}" TextColor="{StaticResource Warning}" FontSize="13"
                                       LineBreakMode="WordWrap" IsVisible="{Binding HasWarning}" />

                                <Label Text="{Binding NextAlarmText}" FontAttributes="Bold" FontSize="14"
                                       LineBreakMode="WordWrap" IsVisible="{Binding HasNextAlarm}" />

                                <Label Text="{Binding ZoneText}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />

                                <Label Text="{DynamicResource L_AlarmsNone}" Style="{StaticResource CaptionLabel}"
                                       IsVisible="{Binding HasAlarms, Converter={StaticResource InvertedBool}}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Alarms}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AlarmRow">
                                            <!--
                                                Deux zones côte à côte, jamais imbriquées : un appui sur la
                                                corbeille ne doit pas aussi ouvrir l'éditeur.
                                            -->
                                            <Border Style="{StaticResource TileCard}" Padding="10,8">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlarmsViewModel}}, Path=EditAlarmCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        </Grid.GestureRecognizers>

                                                        <Label Grid.Column="0" Text="{Binding Time}" FontSize="20" FontAttributes="Bold"
                                                               VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CaptionLabel}"
                                                               LineBreakMode="WordWrap" VerticalOptions="Center" />
                                                        <Label Grid.Column="2" Text="{Binding State}" Style="{StaticResource CaptionLabel}"
                                                               VerticalOptions="Center" />
                                                    </Grid>

                                                    <!-- Corbeille : supprime après confirmation. -->
                                                    <Border Grid.Column="1" Style="{StaticResource IconSquareSmall}" VerticalOptions="Center">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlarmsViewModel}}, Path=DeleteAlarmRowCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Path Style="{StaticResource IconPathSmall}" Fill="{StaticResource DangerBrush}"
                                                              Data="M9,3 H15 V5 H20 V7 H4 V5 H9 Z M6,8 H18 L17,21 H7 Z" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Button Text="{DynamicResource L_AlarmAdd}" Command="{Binding AddAlarmCommand}"
                                        IsVisible="{Binding ShowAddButton}" />

                                <!-- Éditeur d'un réveil -->
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditing}">
                                    <Label Text="{Binding EditorTitle}" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />

                                    <!--
                                        Le sélecteur d'heure du système : sur Android, le cadran
                                        Material. « HH:mm » l'affiche et le règle en 24 heures.
                                    -->
                                    <Label Text="{DynamicResource L_AlarmHour}" Style="{StaticResource CaptionLabel}" />
                                    <TimePicker Time="{Binding AlarmTime, Mode=TwoWay}" Format="HH:mm" FontSize="28" />

                                    <Label Text="{DynamicResource L_AlarmDays}" Style="{StaticResource CaptionLabel}" />
                                    <!-- Raccourcis : cochent d'un coup les jours de semaine, le week-end ou toute la semaine. -->
                                    <HorizontalStackLayout Spacing="8">
                                        <Border Style="{StaticResource Chip}" Padding="12,6">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PickDaysCommand}" CommandParameter="work" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{DynamicResource L_AlarmDaysWork}" FontSize="13" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Padding="12,6">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PickDaysCommand}" CommandParameter="weekend" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{DynamicResource L_AlarmDaysWeekend}" FontSize="13" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Padding="12,6">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PickDaysCommand}" CommandParameter="all" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{DynamicResource L_AlarmDaysAll}" FontSize="13" />
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="2">
                                        <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding Monday, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{DynamicResource L_DayMonday}" VerticalOptions="Center" />
                                        <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding Tuesday, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Grid.Row="0" Grid.Column="3" Text="{DynamicResource L_DayTuesday}" VerticalOptions="Center" />
                                        <CheckBox Grid.Row="0" Grid.Column="4" IsChecked="{Binding Wednesday, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Grid.Row="0" Grid.Column="5" Text="{DynamicResource L_DayWednesday}" VerticalOptions="Center" />
                                        <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding Thursday, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{DynamicResource L_DayThursday}" VerticalOptions="Center" />
                                        <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding Friday, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Grid.Row="1" Grid.Column="3" Text="{DynamicResource L_DayFriday}" VerticalOptions="Center" />
                                        <CheckBox Grid.Row="1" Grid.Column="4" IsChecked="{Binding Saturday, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Grid.Row="1" Grid.Column="5" Text="{DynamicResource L_DaySaturday}" VerticalOptions="Center" />
                                        <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding Sunday, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{DynamicResource L_DaySunday}" VerticalOptions="Center" />
                                    </Grid>

                                    <Label Text="{DynamicResource L_AlarmKeyTitle}" Style="{StaticResource CaptionLabel}" />
                                    <Picker ItemsSource="{Binding KeyLabels}" SelectedIndex="{Binding KeyIndex, Mode=TwoWay}" />

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding UseAlarmVolume, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{DynamicResource L_AlarmUseVolume}" Style="{StaticResource SubtitleLabel}"
                                               VerticalOptions="Center" LineBreakMode="WordWrap" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding UseAlarmVolume}">
                                        <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding AlarmVolume, Mode=TwoWay}"
                                                VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding AlarmVolumeLabel}" WidthRequest="36"
                                               HorizontalTextAlignment="End" VerticalOptions="Center" />
                                    </Grid>

                                    <Label Text="{DynamicResource L_AlarmAutoOffTitle}" Style="{StaticResource CaptionLabel}" />
                                    <Picker ItemsSource="{Binding AutoOffLabels}" SelectedIndex="{Binding AutoOffIndex, Mode=TwoWay}"
                                            IsVisible="{Binding HasOffAt, Converter={StaticResource InvertedBool}}" />
                                    <Label Text="{Binding OffAtNote}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap"
                                           IsVisible="{Binding HasOffAt}" />

                                    <Label Text="{DynamicResource L_AlarmSnoozeTitle}" Style="{StaticResource CaptionLabel}" />
                                    <Picker ItemsSource="{Binding SnoozeLabels}" SelectedIndex="{Binding SnoozeIndex, Mode=TwoWay}" />
                                    <Label Text="{DynamicResource L_AlarmSnoozeNote}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding AlarmEnabled, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{DynamicResource L_AlarmEnabled}" Style="{StaticResource SubtitleLabel}"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0" Text="{DynamicResource L_AlarmSave}" Style="{StaticResource AccentButton}"
                                                Command="{Binding SaveAlarmCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}" />
                                        <Button Grid.Column="1" Text="{DynamicResource L_Cancel}" Command="{Binding CancelEditCommand}" />
                                    </Grid>

                                    <Button Text="{DynamicResource L_AlarmDelete}" Style="{StaticResource QuietButton}"
                                            TextColor="{StaticResource Danger}"
                                            Command="{Binding DeleteAlarmCommand}" IsVisible="{Binding IsExisting}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <Label Text="{Binding StatusMessage}"
                                   TextColor="{Binding IsError, Converter={StaticResource ErrorColor}}"
                                   FontSize="13" LineBreakMode="WordWrap"
                                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Volume de départ : le niveau que prend l'enceinte quand on l'allume. -->
                    <Border Style="{StaticResource Card}" IsVisible="{Binding StartVolumeAvailable}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{DynamicResource L_StartVolumeTitle}" Style="{StaticResource SectionLabel}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <CheckBox Grid.Column="0" IsChecked="{Binding StartVolumeOn, Mode=TwoWay}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{DynamicResource L_StartVolumeUse}" Style="{StaticResource SubtitleLabel}"
                                       VerticalOptions="Center" LineBreakMode="WordWrap" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding StartVolumeOn}">
                                <Slider Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding StartVolumeLevel, Mode=TwoWay}"
                                        VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding StartVolumeLabel}" WidthRequest="36"
                                       HorizontalTextAlignment="End" VerticalOptions="Center" />
                            </Grid>

                            <Label Text="{DynamicResource L_StartVolumeNote}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap" />

                            <Button Text="{DynamicResource L_StartVolumeSave}" Command="{Binding SaveStartVolumeCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ContentView>

            <!-- Apparence -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource L_Language}" Style="{StaticResource SectionLabel}" />

                    <!-- Le Picker travaille sur des chaînes et un index : rien à
                         résoudre pour le compilateur de liaisons. -->
                    <Picker ItemsSource="{Binding LanguageNames}"
                            SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}" />

                    <Label Text="{DynamicResource L_LanguageNote}" Style="{StaticResource CaptionLabel}" />

                    <Label Text="{DynamicResource L_Theme}" Style="{StaticResource SectionLabel}" Margin="0,6,0,0" />

                    <Picker ItemsSource="{Binding ThemeNames}"
                            SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}" />

                    <Label Text="{DynamicResource L_ThemeNote}" Style="{StaticResource CaptionLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource L_Search}" Style="{StaticResource SectionLabel}" />

                    <Button Text="{DynamicResource L_ScanButton}" Style="{StaticResource AccentButton}"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InvertedBool}}" />

                    <ActivityIndicator IsRunning="{Binding IsScanning}" IsVisible="{Binding IsScanning}" />

                    <Label Text="{DynamicResource L_ScanNote}" Style="{StaticResource CaptionLabel}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <!-- Clavier par défaut : le pavé numérique d'Android n'offre pas le point. -->
                        <Entry Grid.Column="0" Text="{Binding ManualHost}" Placeholder="192.168.1.42" />
                        <Button Grid.Column="1" Text="{DynamicResource L_Add}" Command="{Binding AddManualCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource L_KnownSpeakers}" Style="{StaticResource SectionLabel}" />

                    <CollectionView ItemsSource="{Binding KnownSpeakers}" HeightRequest="260">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SpeakerEndpoint">
                                <Grid Padding="0,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}" FontSize="15" />
                                        <Label Text="{Binding Summary}" Style="{StaticResource CaptionLabel}" />

                                        <!--
                                            Le balayage sait déjà si l'agent STR répond : on le dit
                                            plutôt que de laisser deviner pourquoi cette enceinte
                                            offre moins que l'autre.
                                        -->
                                        <Label Text="{DynamicResource L_ReadyForStr}"
                                               IsVisible="{Binding NeedsStr}"
                                               FontSize="12"
                                               TextColor="{StaticResource Warning}" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1" Text="{DynamicResource L_Use}" FontSize="13" Padding="10,6"
                                            MinimumHeightRequest="36"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=SelectCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="2" Text="✕" FontSize="13" Padding="10,6"
                                            MinimumHeightRequest="36"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=ForgetCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <Label Text="{DynamicResource L_NoKnownSpeakers}" Style="{StaticResource CaptionLabel}" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!--
                Bloc d'information, pas d'action : l'installation de l'agent ouvre un
                accès système sur l'enceinte et la redémarre. Cela reste le travail de
                l'outil STR sur ordinateur, qui porte aussi toute la logique de
                récupération. On se contente de signaler et de renvoyer.
            -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasSpeakersWithoutStr}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{DynamicResource L_StrMissingTitle}" Style="{StaticResource SectionLabel}"
                           TextColor="{StaticResource Warning}" />

                    <Label Text="{Binding StrMissingSummary}" FontAttributes="Bold" FontSize="14" />

                    <Label Text="{DynamicResource L_StrMissingBody}" Style="{StaticResource CaptionLabel}" />

                    <Button Text="{DynamicResource L_StrMissingOpen}"
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="{Binding StrWebsite}" />
                </VerticalStackLayout>
            </Border>

            <!-- Même bloc, pour un agent présent mais trop ancien : la mise à jour se fait aussi depuis l'outil STR. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasOutdatedAgents}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{DynamicResource L_AgentOldTitle}" Style="{StaticResource SectionLabel}"
                           TextColor="{StaticResource Warning}" />

                    <Label Text="{Binding OutdatedAgentSummary}" FontAttributes="Bold" FontSize="14" />

                    <Label Text="{DynamicResource L_AgentOldBody}" Style="{StaticResource CaptionLabel}" />

                    <Button Text="{DynamicResource L_AgentOldOpen}"
                            Command="{Binding OpenUrlCommand}"
                            CommandParameter="{Binding StrWebsite}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource L_Diagnostics}" Style="{StaticResource SectionLabel}" />
                    <Button Text="{DynamicResource L_DiagnoseButton}" Command="{Binding DiagnoseCommand}" />

                    <Label Text="{Binding Diagnostics}" FontSize="12" FontFamily="Monospace"
                           IsVisible="{Binding HasDiagnostics}"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                    <Button Text="{DynamicResource L_ClearArtCache}" Command="{Binding ClearArtCacheCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}"
                   TextColor="{Binding IsError, Converter={StaticResource ErrorColor}}"
                   FontSize="13"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />

            <!--
                ================================================= Sauvegarde des favoris
                Sa propre vue-modèle (BackupViewModel), posée par la page dans son
                code, avant celle de la page.
            -->
            <ContentView x:Name="BackupCard" x:DataType="vm:BackupViewModel">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{DynamicResource L_BackupTitle}" Style="{StaticResource SectionLabel}" />
                        <Label Text="{DynamicResource L_BackupHint}" Style="{StaticResource SubtitleLabel}" LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="{DynamicResource L_BackupExport}" Command="{Binding ExportCommand}" />
                            <Button Grid.Column="1" Text="{DynamicResource L_BackupImport}" Command="{Binding ImportCommand}" />
                        </Grid>

                        <Label Text="{Binding StatusMessage}"
                               TextColor="{Binding IsError, Converter={StaticResource ErrorColor}}"
                               FontSize="13" LineBreakMode="WordWrap"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />
                    </VerticalStackLayout>
                </Border>
            </ContentView>

            <!-- ================================================= À propos -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource L_About}" Style="{StaticResource SectionLabel}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding AppVersion}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{DynamicResource L_AppTagline}" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Margin="0,4"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label Text="{DynamicResource L_ThanksTitle}" FontAttributes="Bold" FontSize="15"
                           TextColor="{StaticResource Accent}" />

                    <Label Text="{DynamicResource L_ThanksBody}" Style="{StaticResource SubtitleLabel}" />

                    <Label Text="{DynamicResource L_ThanksLicense}" Style="{StaticResource CaptionLabel}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="{DynamicResource L_OpenWebsite}"
                                Style="{StaticResource AccentButton}" FontSize="13"
                                Command="{Binding OpenUrlCommand}" CommandParameter="{Binding StrWebsite}" />
                        <Button Grid.Column="1" Text="{DynamicResource L_OpenSource}" FontSize="13"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="https://github.com/JRpersonal/streborn" />
                    </Grid>

                    <BoxView HeightRequest="1" Margin="0,4"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label Text="{DynamicResource L_RadioCredit}" Style="{StaticResource CaptionLabel}" />
                    <Label Text="{DynamicResource L_ClaudeCredit}" Style="{StaticResource CaptionLabel}" />

                    <!--
                        Citer une marque pour dire avec quoi l'application est compatible
                        est licite ; laisser croire à une application officielle ne l'est
                        pas. Cette ligne est ce qui distingue les deux.
                    -->
                    <BoxView HeightRequest="1" Margin="0,4"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label Text="{DynamicResource L_IndependenceNotice}" FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />

                    <Label Text="{DynamicResource L_TrademarkNotice}" FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
