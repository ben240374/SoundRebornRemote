<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SoundRebornRemote.App.ViewModels"
             xmlns:views="clr-namespace:SoundRebornRemote.App.Views"
             x:Class="SoundRebornRemote.App.Views.PresetsPage"
             x:DataType="vm:PresetsViewModel"
             Title="{DynamicResource L_TabPresets}">

    <!-- Titre de la page et nom de l'application (AppTitleBar). -->
    <Shell.TitleView>
        <views:AppTitleBar TitleKey="L_TabPresets" />
    </Shell.TitleView>

    <!--
        Toute la page défile d'un seul bloc. Les résultats de recherche sont posés
        par un BindableLayout et non par une CollectionView : une liste défilante
        imbriquée dans un ScrollView se dispute le geste de l'utilisateur et se
        retrouve écrasée sur quelques pixels, ce qui masquait les résultats.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="14,10,14,28" Spacing="12">

            <!-- ================================================= Les six touches -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{DynamicResource L_Presets}" Style="{StaticResource SectionLabel}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{DynamicResource L_Refresh}" Style="{StaticResource QuietButton}"
                                Command="{Binding RefreshCommand}" />
                    </Grid>

                    <!--
                        « Une fois » : les six touches. « Deux fois » : la même touche
                        pressée deux fois, seulement si l'agent de l'enceinte gère ces
                        six touches-là. « Local », à droite : les présélections gardées
                        dans le téléphone, en nombre libre. « ★ STR » : les favoris STR,
                        les mêmes sur toutes les enceintes (agent récent).

                        Les pastilles portent un dessin plutôt qu'un mot, pour tenir sur une
                        ligne : un doigt levé (une fois), deux doigts (deux fois), un téléphone
                        (Local), une étoile (STR). Leur nom reste lu par TalkBack et s'affiche
                        sur un appui long.

                        Deux groupes, chacun d'un seul tenant : « Une fois » et « Deux fois » à
                        gauche, « Local » et « ★ STR » à droite. Quand la largeur ne suffit pas
                        (petit téléphone), le groupe de droite passe à la ligne au lieu de
                        chevaucher celui de gauche. Une puce masquée ne laisse pas de trou : elle
                        est dans un groupe, et le groupe ne compte que ses puces visibles.
                    -->
                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="SpaceBetween" AlignItems="Center">
                        <HorizontalStackLayout Spacing="8" Margin="0,3" FlexLayout.Shrink="0">
                            <Border Style="{StaticResource Chip}" Padding="12,6"
                                    SemanticProperties.Description="{DynamicResource L_RowOnce}"
                                    ToolTipProperties.Text="{DynamicResource L_RowOnce}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowRowCommand}" CommandParameter="1" />
                                </Border.GestureRecognizers>

                                <!-- Pastille : nombre de touches garnies dans la première rangée. -->
                                <HorizontalStackLayout Spacing="6">
                                    <!-- Un doigt levé : une pression sur la touche. -->
                                    <Path Style="{StaticResource IconPath}" WidthRequest="18" HeightRequest="18"
                                          Data="F1 M6.4,14 V3.5 A2,2 0 0 1 10.4,3.5 V14 Z M10.65,13.2 V12.6 A1.75,1.75 0 0 1 14.15,12.6 V13.2 Z M13.85,13.2 V12.6 A1.75,1.75 0 0 1 17.35,12.6 V13.2 Z M8.8,12 H15.4 A3.2,3.2 0 0 1 18.6,15.2 V19.3 A3.2,3.2 0 0 1 15.4,22.5 H8.8 A3.2,3.2 0 0 1 5.6,19.3 V15.2 A3.2,3.2 0 0 1 8.8,12 Z" />
                                    <Border Style="{StaticResource CountBadge}" IsVisible="{Binding ShowFirstRowCount}">
                                        <Label Text="{Binding FirstRowCount}" Style="{StaticResource CountBadgeLabel}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding OnceSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <Border Style="{StaticResource Chip}" Padding="12,6" IsVisible="{Binding HasSecondRow}"
                                    SemanticProperties.Description="{DynamicResource L_RowTwice}"
                                    ToolTipProperties.Text="{DynamicResource L_RowTwice}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowRowCommand}" CommandParameter="2" />
                                </Border.GestureRecognizers>

                                <!-- Pastille : nombre de touches garnies dans cette rangée. -->
                                <HorizontalStackLayout Spacing="6">
                                    <!-- Deux doigts levés : deux pressions sur la touche. -->
                                    <Path Style="{StaticResource IconPath}" WidthRequest="18" HeightRequest="18"
                                          Data="F1 M5.6,14 V4.5 A1.9,1.9 0 0 1 9.4,4.5 V14 Z M9.9,14 V3.4 A1.9,1.9 0 0 1 13.7,3.4 V14 Z M13.9,13.4 V12.8 A1.6,1.6 0 0 1 17.1,12.8 V13.4 Z M8.4,12 H15.4 A3.2,3.2 0 0 1 18.6,15.2 V19.3 A3.2,3.2 0 0 1 15.4,22.5 H8.4 A3.2,3.2 0 0 1 5.2,19.3 V15.2 A3.2,3.2 0 0 1 8.4,12 Z" />
                                    <Border Style="{StaticResource CountBadge}" IsVisible="{Binding ShowSecondRowCount}">
                                        <Label Text="{Binding SecondRowCount}" Style="{StaticResource CountBadgeLabel}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding TwiceSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8" Margin="0,3" FlexLayout.Shrink="0">
                            <Border Style="{StaticResource Chip}" Padding="12,6"
                                    SemanticProperties.Description="{DynamicResource L_RowLocal}"
                                    ToolTipProperties.Text="{DynamicResource L_RowLocal}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowLocalCommand}" />
                                </Border.GestureRecognizers>

                                <!-- Pastille : nombre de présélections locales. -->
                                <HorizontalStackLayout Spacing="6">
                                    <!-- Un téléphone : les présélections gardées dans le téléphone. -->
                                    <Path Style="{StaticResource IconPath}" WidthRequest="18" HeightRequest="18"
                                          Data="F0 M9.0,1.5 H15.0 A2.5,2.5 0 0 1 17.5,4.0 V20.0 A2.5,2.5 0 0 1 15.0,22.5 H9.0 A2.5,2.5 0 0 1 6.5,20.0 V4.0 A2.5,2.5 0 0 1 9.0,1.5 Z M8.9,4.2 H15.1 A0.6,0.6 0 0 1 15.7,4.8 V17.2 A0.6,0.6 0 0 1 15.1,17.8 H8.9 A0.6,0.6 0 0 1 8.3,17.2 V4.8 A0.6,0.6 0 0 1 8.9,4.2 Z M12,19 A1.2,1.2 0 1 1 12,21.4 A1.2,1.2 0 1 1 12,19 Z" />
                                    <Border Style="{StaticResource CountBadge}" IsVisible="{Binding Local.ShowCount}">
                                        <Label Text="{Binding Local.Count}" Style="{StaticResource CountBadgeLabel}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Local.IsShown}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <!-- Favoris STR, quand l'agent les connaît, avec leur nombre en pastille. -->
                            <Border Style="{StaticResource Chip}" Padding="12,6" IsVisible="{Binding Favorites.IsAvailable}"
                                    SemanticProperties.Description="{DynamicResource L_RowFavorites}"
                                    ToolTipProperties.Text="{DynamicResource L_RowFavorites}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowFavoritesCommand}" />
                                </Border.GestureRecognizers>

                                <!-- Une étoile : les favoris STR ; pastille : leur nombre. -->
                                <HorizontalStackLayout Spacing="6">
                                    <Path Style="{StaticResource IconPath}" WidthRequest="18" HeightRequest="18"
                                          Data="F0 M12,2.3 L14.53,9.32 L21.99,9.56 L16.09,14.13 L18.17,21.29 L12,17.1 L5.83,21.29 L7.91,14.13 L2.01,9.56 L9.47,9.32 Z" />
                                    <Border Style="{StaticResource CountBadge}" IsVisible="{Binding Favorites.ShowCount}">
                                        <Label Text="{Binding Favorites.Count}" Style="{StaticResource CountBadgeLabel}" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Favorites.IsShown}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <CollectionView ItemsSource="{Binding Presets}" HeightRequest="308" IsVisible="{Binding ShowKeys}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3"
                                             HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PresetTile">
                                <Border Style="{StaticResource TileCard}" HeightRequest="146">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=RecallCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="28,*,Auto">
                                        <!--
                                            Le nom de la touche, et pour une touche du magasin de
                                            l'agent (1.8.0+) : renommer et effacer. Des boutons et
                                            non des gestes : ils prennent l'appui pour eux, la
                                            touche n'est pas lancée par la même occasion.
                                        -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Padding="8,0,0,0">
                                            <Label Grid.Column="0" Text="{Binding Header}" Style="{StaticResource CaptionLabel}"
                                                   FontSize="11" VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                            <Button Grid.Column="1" Text="✎" Style="{StaticResource TileIconButton}"
                                                    IsVisible="{Binding CanEdit}"
                                                    SemanticProperties.Description="{DynamicResource L_KeyRenameGo}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=RenameKeyCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="2" Text="✕" Style="{StaticResource TileIconButton}"
                                                    TextColor="{StaticResource Danger}"
                                                    IsVisible="{Binding CanEdit}"
                                                    SemanticProperties.Description="{DynamicResource L_KeyClearGo}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=ClearKeyCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>

                                        <Image Grid.Row="1" Source="{Binding ArtSource}" Aspect="AspectFit"
                                               Margin="10,2,10,2" IsVisible="{Binding HasArt}" />

                                        <Label Grid.Row="1" Text="{Binding Glyph}" FontSize="30"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding HasArt, Converter={StaticResource InvertedBool}}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />

                                        <VerticalStackLayout Grid.Row="2" Padding="6,5" Spacing="0">
                                            <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation" MaxLines="1"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource CaptionLabel}"
                                                   LineBreakMode="TailTruncation" MaxLines="1"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource Success}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- La liste « Local », à la place de la grille. Visibilité sur la grille englobante (voir LocalPresetsView). -->
                    <Grid IsVisible="{Binding Local.IsShown}">
                        <views:LocalPresetsView BindingContext="{Binding Local}" />
                    </Grid>

                    <!-- La liste des favoris STR, à la place de la grille, comme « Local ». -->
                    <Grid IsVisible="{Binding Favorites.IsShown}">
                        <views:StrFavoritesView BindingContext="{Binding Favorites}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!--
                ================================================= Copier les touches
                Agent 1.6.5 et suivants. Sa propre vue-modèle, comme les réveils dans
                Réglages : le BindingContext est posé sur le ContentView et le type
                compilé (x:DataType) sur le bloc enfant.
            -->
            <!-- Visibilité portée par un conteneur extérieur : sur la carte intérieure,
                 Android gardait la place d'une carte cachée (bloc vide). -->
            <Grid IsVisible="{Binding Copy.ShowCard}">
                <ContentView BindingContext="{Binding Copy}">
                    <Border x:DataType="vm:PresetCopyViewModel" Style="{StaticResource Card}" IsVisible="{Binding ShowCard}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{DynamicResource L_CopyTitle}" Style="{StaticResource SectionLabel}" />
                            <Label Text="{Binding Hint}" Style="{StaticResource SubtitleLabel}" LineBreakMode="WordWrap" />

                            <Button Text="{DynamicResource L_CopyButton}" Style="{StaticResource AccentButton}"
                                    Command="{Binding CopyCommand}" IsEnabled="{Binding CanCopy}"
                                    IsVisible="{Binding ShowButton}" />

                            <ActivityIndicator IsRunning="{Binding IsCopying}" IsVisible="{Binding IsCopying}"
                                               HorizontalOptions="Start" HeightRequest="24" />

                            <Label Text="{Binding StatusMessage}"
                                   TextColor="{Binding IsError, Converter={StaticResource ErrorColor}}"
                                   FontSize="13" LineBreakMode="WordWrap"
                                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />
                        </VerticalStackLayout>
                    </Border>
                </ContentView>
            </Grid>

            <!-- ================================================= Recherche -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{DynamicResource L_RadioSearch}" Style="{StaticResource SectionLabel}"
                               VerticalOptions="Center" />
                        <ActivityIndicator Grid.Column="1" WidthRequest="18" HeightRequest="18"
                                           IsRunning="{Binding IsSearching}" IsVisible="{Binding IsSearching}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0" Text="{Binding Query}"
                               Placeholder="{DynamicResource L_RadioPlaceholder}"
                               ReturnType="Search" ReturnCommand="{Binding SearchCommand}" />
                        <Button Grid.Column="1" Text="{DynamicResource L_SearchButton}"
                                Style="{StaticResource AccentButton}" Command="{Binding SearchCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Picker Grid.Column="0" ItemsSource="{Binding CountryLabels}"
                                SelectedIndex="{Binding CountryIndex, Mode=TwoWay}"
                                Title="{DynamicResource L_Country}" />
                        <Picker Grid.Column="1" ItemsSource="{Binding LanguageLabels}"
                                SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                                Title="{DynamicResource L_LanguageFilter}" />
                    </Grid>

                    <!-- Tri (relance la recherche) et débit minimal (filtre la liste reçue). -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Picker Grid.Column="0" ItemsSource="{Binding SortLabels}"
                                SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                                Title="{DynamicResource L_SortTitle}" />
                        <Picker Grid.Column="1" ItemsSource="{Binding BitrateLabels}"
                                SelectedIndex="{Binding BitrateIndex, Mode=TwoWay}"
                                Title="{DynamicResource L_BitrateTitle}" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="4">
                        <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding OnlyWorking, Mode=TwoWay}"
                                  VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{DynamicResource L_OnlyWorking}" Style="{StaticResource SubtitleLabel}"
                               VerticalOptions="Center" />
                        <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding BoseCompatibleOnly, Mode=TwoWay}"
                                  VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{DynamicResource L_BoseOnly}" Style="{StaticResource SubtitleLabel}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Genres : « Tous », ceux du pays, la rangée fixe, puis « Plus de genres ». -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Genres}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:GenreChip">
                                    <Border Style="{StaticResource Chip}" Padding="12,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=SelectGenreCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Label}" FontSize="13" VerticalOptions="Center" />
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Button Text="{DynamicResource L_TopStations}" HorizontalOptions="End"
                            Style="{StaticResource QuietButton}" Command="{Binding TopCommand}" />

                </VerticalStackLayout>
            </Border>

            <!-- ================================================= Résultats -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasResults}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding ResultsHeader}" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding FilteredNote}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap"
                           IsVisible="{Binding FilteredNote, Converter={StaticResource StringNotEmpty}}" />
                    <Label Text="{DynamicResource L_RelaxedHint}" Style="{StaticResource CaptionLabel}" LineBreakMode="WordWrap"
                           TextColor="{StaticResource Warning}" IsVisible="{Binding IsRelaxed}" />

                    <!-- Écoute en cours sur l'appareil : ce qui joue, où, et comment l'arrêter. -->
                    <Border Style="{StaticResource TileCard}" Padding="10,8" IsVisible="{Binding IsPreviewActive}"
                            Stroke="{StaticResource AccentBrush}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding PreviewBarText}" FontSize="14" LineBreakMode="WordWrap" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="{DynamicResource L_PreviewStop}" Command="{Binding StopListeningCommand}" />
                                <Button Grid.Column="1" Text="{Binding PreviewBroadcastText}" LineBreakMode="WordWrap"
                                        Style="{StaticResource AccentButton}" Command="{Binding BroadcastPreviewCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:RadioResult">
                                <VerticalStackLayout Spacing="8" Padding="0,0,0,6">
                                <!-- Toucher la ligne l'ouvre : écouter ici, diffuser sur l'enceinte, ou le menu. -->
                                <Grid Padding="2,10,2,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=ToggleRowCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Border Grid.Column="0" Style="{StaticResource TileCard}"
                                            WidthRequest="46" HeightRequest="46">
                                        <Grid>
                                            <Image Source="{Binding Logo}" Aspect="AspectFit" Margin="5"
                                                   IsVisible="{Binding HasLogo}" />
                                            <Label Text="♪" FontSize="17" HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding HasLogo, Converter={StaticResource InvertedBool}}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="15"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding Summary}" Style="{StaticResource CaptionLabel}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{DynamicResource L_StationUnchecked}" Style="{StaticResource CaptionLabel}"
                                               TextColor="{StaticResource Warning}" IsVisible="{Binding IsUnreachable}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="›" FontSize="22" VerticalOptions="Center"
                                           TextColor="{StaticResource Accent}" />
                                </Grid>

                                <!-- Ligne ouverte : deux grands boutons sans ambiguïté, puis le menu. -->
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsExpanded}">
                                    <Button Text="{Binding ListenText}" LineBreakMode="WordWrap"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=ListenHereCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="{Binding BroadcastText}" LineBreakMode="WordWrap" Style="{StaticResource AccentButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=BroadcastCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="{DynamicResource L_MoreActions}" Style="{StaticResource QuietButton}" HorizontalOptions="Start"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PresetsViewModel}}, Path=StationActionCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="{DynamicResource L_LoadMore}" Style="{StaticResource QuietButton}"
                            Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" />
                </VerticalStackLayout>
            </Border>

            <!-- Une station absente de l'annuaire : chacun peut l'y ajouter, pour tout le monde. -->
            <Label Text="{DynamicResource L_AddMissingStation}" Style="{StaticResource CaptionLabel}"
                   LineBreakMode="WordWrap" TextColor="{StaticResource Accent}" IsVisible="{Binding HasSearched}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddMissingStationCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="{DynamicResource L_PresetsHint}" Style="{StaticResource CaptionLabel}"
                   IsVisible="{Binding HasResults, Converter={StaticResource InvertedBool}}" />

            <Label Text="{DynamicResource L_RadioSource}" Style="{StaticResource CaptionLabel}" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="{Binding IsError, Converter={StaticResource ErrorColor}}"
                   FontSize="13"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
