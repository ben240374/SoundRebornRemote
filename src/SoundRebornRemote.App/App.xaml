<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:SoundRebornRemote.App.Converters"
             x:Class="SoundRebornRemote.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InvertedBoolConverter x:Key="InvertedBool" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmpty" />
            <converters:ErrorColorConverter x:Key="ErrorColor" />
            <converters:ReadyOpacityConverter x:Key="ReadyOpacity" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
