<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- L'enceinte parle en HTTP simple sur le LAN : sans cette autorisation,
       Android 9+ bloque silencieusement toutes les requêtes. -->
  <application android:allowBackup="true"
               android:icon="@mipmap/appicon"
               android:roundIcon="@mipmap/appicon_round"
               android:supportsRtl="true"
               android:usesCleartextTraffic="true"
               android:networkSecurityConfig="@xml/network_security_config" />

  <!-- Depuis Android 11, une application ne voit les autres que si elle les
       déclare. Sans ce bloc, les liens « Site du projet STR » des réglages
       n'ouvriraient aucun navigateur, et sans erreur visible. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:scheme="https" />
    </intent>
  </queries>

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

  <!-- Utile seulement si tu ajoutes plus tard une découverte mDNS. -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

</manifest>
