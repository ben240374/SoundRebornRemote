<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Passe en net9.0 ou net8.0 si ton Visual Studio n'a pas encore le SDK .NET 10.
         Il faut alors aligner le TargetFramework de l'app MAUI (net9.0-android / net8.0-android). -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SoundReborn.Core</RootNamespace>
    <AssemblyName>SoundReborn.Core</AssemblyName>
  </PropertyGroup>

</Project>
